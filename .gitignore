# Python and tooling
.venv/
.venv-gpu/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python package and application build output
dist/
build/
*.egg-info/

# Local configuration and credentials
.env
.env.*
*.pem
*.key
*.token
*.secret
secrets/

# Runtime data and generated reports
storage/*
!storage/sessions/

models/**/*.pth
models/**/*.onnx
models/**/*.engine
models/**/*.tflite
models/**/*.task
models/**/*.safetensors
models/**/*.bin
models/**/*.zip
models/pretrained/*
!models/pretrained/.gitkeep
models/custom/*
!models/custom/.gitkeep

